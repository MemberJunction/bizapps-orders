{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "mj-bizapps-orders",
  "displayName": "BizApps Orders",
  "description": "Product catalog + order lifecycle for MemberJunction. Confirmed orders emit balanced journal entries into BizApps Accounting via the Accounting.CreateJournalEntry remote operation; GL account resolution rides accounting's polymorphic GLAccountLink system (no GL columns here).",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-cart-shopping",
  "color": "#1F7A4D",
  "publisher": {
    "name": "MemberJunction",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/bizapps-orders",
  "mjVersionRange": ">=5.44.0 <6.0.0",
  "dependencies": {
    "mj-bizapps-accounting": {
      "version": ">=1.0.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-accounting"
    }
  },
  "schema": {
    "name": "__mj_BizAppsOrders",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-biz-apps/orders-server",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsOrdersServer"
      }
    ],
    "client": [
      {
        "name": "@mj-biz-apps/orders-ng",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsOrdersClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-biz-apps/orders-entities",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/orders-actions",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "Business",
    "Sales",
    "Orders"
  ],
  "tags": [
    "orders",
    "product-catalog",
    "sales",
    "accounts-receivable",
    "revenue-recognition",
    "journal-entry"
  ]
}
