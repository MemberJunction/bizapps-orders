{
  "name": "bizapps-orders",
  "version": "0.1.0",
  "license": "ISC",
  "description": "BizApps Orders - unified order management (products, orders, payments, subscriptions) built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-entities\" --filter=\"@mj-biz-apps/orders-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsOrders --dir ./migrations",
    "mj:codegen": "mj codegen",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "test:unit": "vitest run",
    "test:integration": "node test-harnesses/integration.mjs",
    "test:coverage-gate": "node scripts/assert-check-count.mjs",
    "verify": "pnpm run test:unit && pnpm run build && pnpm run test:integration 2>&1 | tee /tmp/integration.log && node scripts/assert-check-count.mjs /tmp/integration.log"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-orders"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@memberjunction/actions": "^6.1.0-edge.1",
    "@memberjunction/cli": "^6.1.0-edge.1",
    "@memberjunction/core": "^6.1.0-edge.1",
    "@memberjunction/generic-database-provider": "^6.1.0-edge.1",
    "@memberjunction/global": "^6.1.0-edge.1",
    "@memberjunction/sqlserver-dataprovider": "^6.1.0-edge.1",
    "@memberjunction/templates": "^6.1.0-edge.1",
    "@memberjunction/testing-integration": "^6.1.0-edge.1",
    "@mj-biz-apps/orders-core-entities-server": "^5.0.0",
    "@mj-biz-apps/orders-integration-tests": "^5.0.0",
    "@mj-biz-apps/orders-server": "^5.0.0",
    "beasties": "0.3.5",
    "dotenv": "^17.2.3",
    "mrmime": "2.0.1",
    "mssql": "^11.0.1",
    "playwright": "^1.50.0",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
