{
  "name": "bizapps-orders",
  "version": "0.1.0",
  "license": "ISC",
  "description": "BizApps Orders - unified order management (products, orders, payments, subscriptions) built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-entities\" --filter=\"@mj-biz-apps/orders-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsOrders --dir ./migrations",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsOrders",
    "mj:codegen": "mj codegen",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "test:unit": "vitest run",
    "test:integration": "node test-harnesses/integration.mjs",
    "test:coverage-gate": "node scripts/assert-check-count.mjs",
    "verify": "pnpm run test:unit && pnpm run build && pnpm run test:integration 2>&1 | tee /tmp/integration.log && node scripts/assert-check-count.mjs /tmp/integration.log"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-orders"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@memberjunction/actions": "6.1.0-edge.2",
    "@memberjunction/cli": "6.1.0-edge.2",
    "@memberjunction/core": "6.1.0-edge.2",
    "@memberjunction/generic-database-provider": "6.1.0-edge.2",
    "@memberjunction/global": "6.1.0-edge.2",
    "@memberjunction/sqlserver-dataprovider": "6.1.0-edge.2",
    "@memberjunction/templates": "6.1.0-edge.2",
    "@memberjunction/testing-integration": "6.1.0-edge.2",
    "@mj-biz-apps/orders-core-entities-server": "^5.0.0",
    "@mj-biz-apps/orders-integration-tests": "^5.0.0",
    "@mj-biz-apps/orders-server": "^5.0.0",
    "beasties": "0.3.5",
    "dotenv": "^17.2.3",
    "mrmime": "2.0.1",
    "mssql": "^11.0.1",
    "playwright": "^1.50.0",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@angular/animations": "21.1.3",
      "@angular/build": "21.1.3",
      "@angular/cli": "21.1.3",
      "@angular/common": "21.1.3",
      "@angular/compiler": "21.1.3",
      "@angular/compiler-cli": "21.1.3",
      "@angular/core": "21.1.3",
      "@angular/forms": "21.1.3",
      "@angular/localize": "21.1.3",
      "@angular/platform-browser": "21.1.3",
      "@angular/platform-browser-dynamic": "21.1.3",
      "@angular/router": "21.1.3",
      "@angular-devkit/build-angular": "21.1.3",
      "@memberjunction/core": "^6.1.0-edge.2",
      "@memberjunction/global": "^6.1.0-edge.2",
      "graphql": "16.14.2",
      "type-graphql": "2.0.0-beta.3",
      "reflect-metadata": "0.2.2"
    }
  }
}
