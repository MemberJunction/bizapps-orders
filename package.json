{
  "name": "bizapps-orders",
  "version": "1.0.0",
  "license": "ISC",
  "description": "BizApps Orders - product catalog + order lifecycle that books balanced journal entries into BizApps Accounting, built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-entities\" --filter=\"@mj-biz-apps/orders-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-*\"",
    "test": "turbo --log-order=stream test --filter=\"@mj-biz-apps/orders-*\"",
    "mj:migrate": "mj migrate --schema __mj_BizAppsOrders --dir ./migrations",
    "mj:codegen": "mj codegen",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-orders"
  },
  "packageManager": "npm@10.5.0",
  "devDependencies": {
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^5.44.0",
    "@memberjunction/core": "^5.44.0",
    "@memberjunction/global": "^5.44.0",
    "@memberjunction/ng-base-forms": "^5.44.0",
    "@memberjunction/ng-entity-viewer": "^5.44.0",
    "@memberjunction/ng-link-directives": "^5.44.0",
    "@memberjunction/server": "^5.44.0",
    "@types/node": "^22.10.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
