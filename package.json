{
  "name": "bizapps-orders",
  "version": "0.1.0",
  "license": "ISC",
  "description": "BizApps Orders - unified order management (products, orders, payments, subscriptions) built on MemberJunction",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-entities\" --filter=\"@mj-biz-apps/orders-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/orders-*\"",
    "build:api": "turbo --log-order=stream build --filter=\"mj_api\"",
    "build:explorer": "turbo --log-order=stream build --filter=\"mj_explorer\"",
    "start": "turbo start --filter=mj_explorer --filter=mj_api",
    "start:api": "turbo start --filter=mj_api",
    "start:explorer": "turbo start --filter=mj_explorer",
    "mj": "node node_modules/@memberjunction/cli/bin/run.js",
    "mj:migrate": "node node_modules/@memberjunction/cli/bin/run.js migrate",
    "mj:codegen": "node node_modules/@memberjunction/cli/bin/run.js codegen",
    "postinstall": "node scripts/link-local-apps.mjs",
    "link:local": "node scripts/link-local-apps.mjs",
    "install:deps": "npm install",
    "setup": "echo 'Please run: npm run mj:migrate && npm run mj:codegen && npm run build'",
    "test:unit": "vitest run",
    "test:integration": "node test-harnesses/integration.mjs",
    "test:coverage-gate": "node scripts/assert-check-count.mjs",
    "verify": "npm run test:unit && npm run build && npm run test:integration 2>&1 | tee /tmp/integration.log && node scripts/assert-check-count.mjs /tmp/integration.log"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-orders"
  },
  "packageManager": "npm@10.5.0",
  "overrides": {
    "@angular/animations": "21.1.3",
    "@angular/build": "21.1.3",
    "@angular/cli": "21.1.3",
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@angular/localize": "21.1.3",
    "@angular/platform-browser": "21.1.3",
    "@angular/platform-browser-dynamic": "21.1.3",
    "@angular/router": "21.1.3",
    "@angular-devkit/build-angular": "21.1.3",
    "@memberjunction/core": "^5.50.0",
    "@memberjunction/global": "^5.50.0",
    "graphql": "16.14.2",
    "type-graphql": "2.0.0-beta.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@memberjunction/actions": "^6.1.0-edge.1",
    "@memberjunction/cli": "^6.1.0-edge.1",
    "@memberjunction/core": "^6.1.0-edge.1",
    "@memberjunction/global": "^6.1.0-edge.1",
    "@memberjunction/sqlserver-dataprovider": "^6.1.0-edge.1",
    "@memberjunction/templates": "^6.1.0-edge.1",
    "@memberjunction/testing-integration": "^6.1.0-edge.1",
    "@mj-biz-apps/accounting-engine-base": "^0.1.0",
    "@mj-biz-apps/accounting-server": "^0.1.0",
    "@mj-biz-apps/orders-core-entities-server": "^5.0.0",
    "@mj-biz-apps/orders-integration-tests": "^5.0.0",
    "@mj-biz-apps/orders-server": "^5.0.0",
    "beasties": "0.3.5",
    "dotenv": "^17.2.3",
    "mrmime": "2.0.1",
    "mssql": "^11.0.1",
    "playwright": "^1.50.0",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
