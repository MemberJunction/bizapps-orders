# pnpm settings for this repo, matching bizapps-common/accounting (the family
# baseline) — with ONE deliberate divergence, explained below.
#
# package-manager-strict: allows pnpm to run in a tree whose packageManager field
#   may disagree (e.g. when this repo is linked as a member of an MJ 6.x checkout
#   alongside repos that still pin npm).
# strict-peer-dependencies: peer mismatches warn instead of failing. The estate
#   straddles 6.1.0-edge.x peer pins, so mismatches are expected.
# auto-install-peers: FALSE here, unlike common/accounting (true). With it on,
#   every unsatisfied peer range becomes an install instruction — and this repo's
#   packages declare the UNPUBLISHED @mj-biz-apps/accounting-* as mandatory peers,
#   which would be fatal registry 404s and no lockfile could exist. Flip to true
#   (family baseline) when accounting publishes.
#
# Any stray `npm` command will print "Unknown project config" for these lines —
# that is npm not recognising pnpm settings, not breakage.
package-manager-strict=false
strict-peer-dependencies=false
auto-install-peers=false
