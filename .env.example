# Copy to .env (gitignored) and fill in. Read by mj.config.cjs, the MJ CLI (mj migrate, mj codegen,
# mj sync, mj test), scripts/*.sh and test-harnesses/*.mjs. The scripts source .env as shell, so
# keep values free of spaces or quote them.

# SQL Server connection. mj sync, mj test, the scripts and the harnesses log in with DB_USERNAME.
# scripts/rebuild-db.sh also drops and creates the database with this login, so for that it needs
# dbcreator rights (sa on a local container).
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=bizapps_orders
DB_USERNAME=orders_app
DB_PASSWORD=change-me
# 1 or true to accept a self-signed certificate, such as a local container's. Read by the MJ CLI and
# scripts/backfill-checkout-answers.mjs; the harnesses and shell scripts always trust the certificate.
DB_TRUST_SERVER_CERTIFICATE=1

# mj migrate and mj codegen use the connection above but log in with this login instead
CODEGEN_DB_USERNAME=orders_codegen
CODEGEN_DB_PASSWORD=change-me

# MJ core schema; defaults to __mj
# MJ_CORE_SCHEMA=__mj

# Cloudflare Turnstile secret for the checkout edge. Only needed when a checkout widget sets
# requireTurnstile; the edge reads the variable named by Settings.TurnstileSecretEnvVar and pairs it
# with Settings.TurnstileSiteKey. Setup: docs/checkout-widget-and-session-architecture.md#turnstile
# CHECKOUT_TURNSTILE_SECRET=

# Signs the update-card link e-mailed when a renewal charge fails; 32 characters or more. Without it
# no link is sent or accepted. The link address is Settings.RenewalPaymentLinkBaseUrl.
# Setup: docs/checkout-widget-and-session-architecture.md
# ORDERS_RENEWAL_LINK_SECRET=

# CodeGen also needs an AI vendor key in this file. CLAUDE.md, "CodeGen output must be reproducible
# from this repo", names it.

# scripts/rebuild-db.sh only.
# The MJ git tag whose core migrations it applies. Keep it equal to the @memberjunction/core version
# pnpm-lock.yaml resolves; the script's built-in default is older.
MJ_CORE_VERSION=v6.1.5
# Optional; each default is shown.
# Sibling checkouts whose migrations and seed metadata it applies
# BIZAPPS_COMMON_REPO=../bizapps-common
# BIZAPPS_TASKS_REPO=../bizapps-tasks       (tasks 1.8 or later; the script refuses older)
# BIZAPPS_ACCOUNTING_REPO=../bizapps-accounting
# The human user it creates for the integration suite
# INTEGRATION_USER_EMAIL=integration.user@example.com
