{
  "name": "@mj-biz-apps/orders-ng",
  "type": "module",
  "version": "5.0.0",
  "description": "BizApps Orders Angular bootstrap - generated form components and module for the unified order-management Open App",
  "main": "dist/public-api.js",
  "types": "dist/public-api.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "ngc && npm run build:styles",
    "test": "echo \"No tests configured yet\"",
    "build:styles": "node -e \"require('node:fs').mkdirSync('dist/lib/styles',{recursive:true});require('node:fs').copyFileSync('src/lib/styles/orders-kit.css','dist/lib/styles/orders-kit.css')\""
  },
  "author": "MemberJunction.com",
  "license": "ISC",
  "dependencies": {
    "@mj-biz-apps/orders-entities": "5.0.0",
    "ag-grid-angular": "^35.0.1",
    "ag-grid-community": "^35.0.1"
  },
  "peerDependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@memberjunction/core": "^5.50.0",
    "@memberjunction/core-entities": "^5.50.0",
    "@memberjunction/global": "^5.50.0",
    "@memberjunction/actions-base": "^5.50.0",
    "@memberjunction/graphql-dataprovider": "^5.50.0",
    "@memberjunction/ng-base-forms": "^5.50.0",
    "@memberjunction/ng-entity-viewer": "^5.50.0",
    "@memberjunction/ng-link-directives": "^5.50.0",
    "@memberjunction/ng-shared": "^5.50.0",
    "@memberjunction/ng-ui-components": "^5.50.0"
  },
  "devDependencies": {
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/animations": "21.1.3",
    "@angular/common": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-orders"
  },
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
    "./styles/orders-kit.css": "./dist/lib/styles/orders-kit.css"
  }
}
