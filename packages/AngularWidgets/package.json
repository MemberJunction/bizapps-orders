{
  "name": "@mj-biz-apps/orders-ng-widgets",
  "type": "module",
  "version": "5.0.0",
  "description": "BizApps Orders reusable Angular widgets (UI layers 1 + 2) \u2014 the panel vocabulary and the screen composites. Framework-clean: no routing, no MJ Explorer dependency.",
  "main": "dist/public-api.js",
  "types": "dist/public-api.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "ngc && npm run build:styles",
    "test": "echo \"Run from the repo root: npx vitest run (root vitest.config.ts covers packages/*/src)\"",
    "build:styles": "node -e \"require('node:fs').mkdirSync('dist/lib/styles',{recursive:true});require('node:fs').copyFileSync('src/lib/styles/orders-kit.css','dist/lib/styles/orders-kit.css')\""
  },
  "author": "MemberJunction.com",
  "license": "ISC",
  "dependencies": {
    "@mj-biz-apps/orders-entities": "5.0.0"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0 <22.0.0",
    "@angular/core": ">=21.0.0 <22.0.0",
    "@angular/forms": ">=21.0.0 <22.0.0",
    "@memberjunction/core": "^5.50.0",
    "@memberjunction/core-entities": "^5.50.0",
    "@memberjunction/global": "^5.50.0",
    "@memberjunction/ng-base-types": "^5.50.0",
    "@memberjunction/ng-shared-generic": "^5.50.0",
    "@memberjunction/ng-ui-components": "^5.50.0"
  },
  "devDependencies": {
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-orders"
  },
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
    "./styles/orders-kit.css": "./dist/lib/styles/orders-kit.css"
  },
  "mjUILayer": "widgets"
}
