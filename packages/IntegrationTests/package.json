{
  "name": "@mj-biz-apps/orders-integration-tests",
  "type": "module",
  "version": "5.50.0",
  "private": true,
  "description": "Integration check bundles for BizApps Orders, dispatched by `mj test` via MJ's testing framework.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./checks/*": "./dist/checks/*.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias -f && node -e \"const fs=require('fs');const p=require('path');const s='src/world/data';const d='dist/world/data';fs.mkdirSync(d,{recursive:true});for (const f of fs.readdirSync(s)) fs.copyFileSync(p.join(s,f),p.join(d,f));\"",
    "test": "vitest run --root ../.. packages/IntegrationTests/"
  },
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@mj-biz-apps/accounting-engine-base": ">=0.24.0",
    "@mj-biz-apps/accounting-server": ">=0.24.0",
    "@mj-biz-apps/common-entities": ">=5.56.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@mj-biz-apps/orders-entities": "^5.50.0",
    "@mj-biz-apps/orders-server": "^5.50.0",
    "@mj-biz-apps/orders-core-entities-server": "^5.50.0"
  },
  "peerDependencies": {
    "@memberjunction/core": "^6.2.1",
    "@memberjunction/global": "^6.2.1",
    "@memberjunction/testing-integration": "^6.2.1",
    "@mj-biz-apps/accounting-engine-base": ">=0.24.0",
    "@mj-biz-apps/accounting-server": ">=0.24.0",
    "@mj-biz-apps/common-entities": ">=5.56.0",
    "@memberjunction/actions": "^6.2.1",
    "@memberjunction/actions-base": "^6.2.1",
    "@memberjunction/core-entities": "^6.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-orders"
  }
}
